{
  "name": "cursor-mcp-bridge-server",
  "version": "1.0.0",
  "description": "MCP server for Cursor Project Advisor - 利用Cursor代码库检索能力提供项目咨询服务",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:websocket": "tsc --outDir dist-websocket",
    "dev": "tsx watch src/index.ts",
    "dev:websocket": "tsx watch src/index-websocket.ts",
    "start": "node dist/index.js",
    "start:websocket": "node dist-websocket/index-websocket.js",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "keywords": ["mcp", "cursor", "bridge"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}