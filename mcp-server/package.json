{
  "name": "cursor-mcp-bridge",
  "version": "1.3.0",
  "description": "MCP server for Cursor Project Advisor - Bridge Claude Code with Cursor AI for intelligent project consultation",
  "main": "dist/index-correct.js",
  "type": "module",
  "bin": {
    "cursor-mcp-bridge": "bin/cursor-mcp-bridge-cli"
  },
  "scripts": {
    "build": "tsc",
    "build:websocket": "tsc --outDir dist-websocket",
    "dev": "tsx watch src/index.ts",
    "dev:websocket": "tsx watch src/index-websocket.ts",
    "start": "node dist/index-correct.js",
    "start:websocket": "node dist-websocket/index-websocket.js",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "cursor",
    "bridge",
    "claude",
    "ai",
    "cli"
  ],
  "author": "Vanyangyang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vanyangyang/cursor-bridge.git"
  },
  "homepage": "https://github.com/Vanyangyang/cursor-bridge#readme",
  "bugs": {
    "url": "https://github.com/Vanyangyang/cursor-bridge/issues"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
